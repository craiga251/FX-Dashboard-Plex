# Perplexity API key — get yours from https://www.perplexity.ai/settings/api
GEMINI_API_KEY=your_perplexity_api_key_here

# Model to use (sonar is recommended for live web-grounded analysis)
PPLX_MODEL=gemini-2.0-flash

# Timeframe focus passed into the analysis prompt
ANALYSIS_TIMEFRAME=1H / 4H focus, daily context

# File paths (defaults shown — change if needed)
OUTPUT_JSON=core_pairs_latest.json
DASHBOARD_TEMPLATE=dashboard_template.html
DASHBOARD_OUTPUT=dashboard_generated.html
