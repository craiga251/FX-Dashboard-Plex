# Gemini API key — get yours from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Model to use with the Gemini OpenAI-compatible endpoint
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite
GEMINI_MAX_RETRIES=3
GEMINI_RETRY_BACKOFF_SECONDS=10
GEMINI_MAX_OUTPUT_TOKENS=8192

# Timeframe focus passed into the analysis prompt
ANALYSIS_TIMEFRAME=1H / 4H focus, daily context

# File paths (defaults shown — change if needed)
OUTPUT_JSON=core_pairs_latest.json
DASHBOARD_TEMPLATE=fx_orginal_template.html
DASHBOARD_OUTPUT=dashboard_generated.html
